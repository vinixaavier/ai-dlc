{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "agentic-call-flow"
  },
  "spec": {
    "title": "Agentic Call Flow: pi / kagent \u2192 AgentGateway \u2192 SGLang",
    "description": "Top-to-bottom view of the agentic call path: agentic clients (pi, kagent MCP clients) call AgentGateway (A2A/MCP/OpenAI routing), which serves MCP tool routes and proxies LLM traffic to the external SGLang backend (qwen3.8-27b-nvfp4). Read top-down: client traffic first, then gateway internals, then the LLM backend.",
    "tags": [
      "ai-dlc",
      "agentic",
      "agentgateway",
      "sglang"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "schemaVersion": 36,
    "templating": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Gateway request rate (all routes)",
        "description": "All client requests hitting AgentGateway.",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(agentgateway_requests_total[5m]))",
            "legendFormat": "rps",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "MCP tool calls/s",
        "description": "MCP client\u2192gateway calls served by kagent MCP servers (kagent-tools, kagent-grafana-mcp).",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 4,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(agentgateway_mcp_requests_total[5m]))",
            "legendFormat": "calls/s",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "LLM requests/s (\u2192 SGLang)",
        "description": "Gen-AI chat requests routed from AgentGateway to the SGLang model backend.",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 8,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(agentgateway_gen_ai_server_request_duration_count[5m]))",
            "legendFormat": "llm req/s",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Tokens/s (in + out + cache)",
        "description": "Gen-AI token throughput measured at the gateway.",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 12,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(agentgateway_gen_ai_client_token_usage_sum[5m]))",
            "legendFormat": "tokens/s",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "type": "stat",
        "title": "LLM TTFT p95",
        "description": "95th percentile time-to-first-token on LLM requests.",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 16,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(agentgateway_gen_ai_server_time_to_first_token_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "type": "stat",
        "title": "Shed requests/s",
        "description": "Load-shed requests + shed downstream connections. Healthy state is flat 0.",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 20,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(agentgateway_requests_shed_total[5m])) + sum(rate(agentgateway_downstream_connections_shed_total[5m]))",
            "legendFormat": "shed/s",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "type": "row",
        "title": "1 \u00b7 Clients (pi / kagent) \u2192 AgentGateway",
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 4
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "panels": []
      },
      {
        "id": 20,
        "type": "timeseries",
        "title": "Request rate by route (backend)",
        "description": "Where client traffic lands: MCP tool routes (kagent) vs the LLM route to SGLang.",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "mean",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "expr": "sum by (backend) (rate(agentgateway_requests_total[5m]))",
            "legendFormat": "{{backend}}",
            "refId": "A"
          }
        ]
      },
